# Copy this file to .env and fill in your own values
DJANGO_SECRET_KEY=generate-one-with-get_random_secret_key
DJANGO_DEBUG=True
# host.docker.internal: lets the M&E tool (in Docker) reach this API
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

DB_NAME=wellness_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306