# Copy to frontend/.env.local only if you need these on this computer.
# On Railway, set them as variables of the frontend service (they are read
# when the app is built, so redeploy after changing them).

# The wellness API, ending in /api. Leave empty on this computer: Vite
# forwards /api to http://127.0.0.1:8000.
VITE_API_URL=

# The M&E tool's address
VITE_ME_URL=http://localhost:8100
