# Copy this file to .env and fill in the values (never commit .env)

# ---- Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8100
TIME_ZONE=Africa/Kigali
# Set to 1 when the tool is served over HTTPS
SECURE_COOKIES=0

# ---- PostgreSQL (the "db" container)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=me_tool
POSTGRES_USER=me_tool
POSTGRES_PASSWORD=change-me

# ---- Celery (the "redis" container)
CELERY_BROKER_URL=redis://redis:6379/0

# ---- The wellness system
# A wellness system running on this computer, seen from inside Docker:
WELLNESS_API_URL=http://host.docker.internal:8000
# The service account: a user with the role "M&E sync service" in the wellness system
WELLNESS_SYNC_USERNAME=me_sync
WELLNESS_SYNC_PASSWORD=change-me
# Pull new and changed data every N minutes; the nightly check looks back N days
SYNC_INTERVAL_MINUTES=30
RECONCILE_DAYS=14
# Daily (every morning), weekly (Mondays) and monthly (1st) reports for all companies
AUTO_REPORTS=1

# ---- System resources page: a sample every N minutes, kept N days; warning limits
MONITOR_INTERVAL_MINUTES=10
MONITOR_RETENTION_DAYS=30
MONITOR_ALERT_CPU=85
MONITOR_ALERT_MEMORY=90
MONITOR_ALERT_DISK=85
MONITOR_ALERT_SYNC_HOURS=2

# ---- Web port on this computer: http://localhost:8100
ME_PORT=8100
